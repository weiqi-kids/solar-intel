{"id": "unknown-2026-05-25-014", "date": "2026-05-25", "time_tags": {"year": 2026, "quarter": "Q2", "month": 5, "week": 22, "weekday": "Mon"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["industry_general"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "DAS Solar, UNSW build tunnel back-contact solar cell with 27% efficiency, lower silver content", "content": "Researchers from UNSW and DAS Solar developed a zero-busbar metal grid optimization approach for tunnel oxide passivated back-contact (TBC) silicon solar cells, enabling more efficient current collection at the rear surface while reducing silver consumption by 3–4 mg/W. The first TBC cells produced in mass manufacturing using this technique have demonstrated efficiencies exceeding 27%.", "sources": [{"name": "pv_magazine", "url": "https://www.pv-magazine.com/2026/05/25/das-solar-unsw-build-tunnel-back-contact-solar-cell-with-27-efficiency-lower-silver-content/", "type": "rss"}]}
{"id": "unknown-2026-05-25-015", "date": "2026-05-25", "time_tags": {"year": 2026, "quarter": "Q2", "month": 5, "week": 22, "weekday": "Mon"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["industry_general"], "sentiment": {"label": "negative", "score": -1.0, "keywords": ["loss", "decline"]}, "importance": {"score": 0.65, "reasons": ["情緒極端"]}, "title": "Pollution from coal plants can reduce solar generation by over 5%", "content": "Research from the UK finds aerosols reduced global solar output by 5.8% in 2023, equivalent to 111 TWh. While China accounted for over half the global total in 2023, the country is the only major solar-producing region found to be demonstrating a decline in annual losses.", "sources": [{"name": "pv_magazine", "url": "https://www.pv-magazine.com/2026/05/25/pollution-from-coal-plants-can-reduce-solar-generation/", "type": "rss"}]}
